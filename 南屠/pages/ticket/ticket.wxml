<view class="container">
    <view class="top-title">请选择参观日期</view>
    <view class="month flex m-center">
        <view bindtap="doDay" class="arrow leui-icon-prev" data-key="left" wx:if="{{flag==-1}}"></view>
        <view class="picker-box flex s-center m-center">{{showMonth}}</view>
        <view bindtap="doDay" class="arrow leui-icon-next" data-key="right" wx:if="{{flag==1}}"></view>
    </view>
    <view class="calendar flex column s-center">
        <view class="weeks flex m-around">
            <view class="grid" wx:for="{{week}}" wx:key="item">
                <view>{{item}}</view>
            </view>
        </view>
        <view class="flex m-around days-table">
            <view class="grid" wx:for="{{currentDayList}}" wx:for-index="key" wx:for-item="vo" wx:key="{{key}}">
                <button bindtap="toReservation" class="day flex column s-center m-center {{vo.styl}}" data-date="{{vo.date}}" data-id="{{vo.id}}" data-index="{{key}}" data-styl="{{vo.styl}}">
                    <text>{{vo.day}}</text>
                    <text class="day-info">{{vo.content}}</text>
                </button>
            </view>
        </view>
    </view>
    <view class="tip-box">
        <image class="iprompt" mode="widthFix" src="/lib/images/iprompt.png"></image>
        <rich-text class="tip-text" nodes="{{ticketTip}}"></rich-text>
    </view>
</view>
