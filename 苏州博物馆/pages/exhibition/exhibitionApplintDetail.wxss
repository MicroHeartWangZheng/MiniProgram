page {
    padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx)
}

.descView {
    background-color: #fff;
    border-radius: 10rpx;
    padding: 20rpx 0rpx
}

.descView,.row {
    margin: 30rpx 30rpx 0rpx
}

.row {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-start;
    justify-content: flex-start
}

.row_title {
    color: #2d2d2d;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 25rpx;
    font-weight: 400
}

.row_content {
    color: #a1a1a1;
    font-size: 25rpx;
    margin-left: 21rpx
}

.type_label {
    background: var(--themeColor);
    border-radius: 8rpx;
    color: #fff;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 30rpx;
    height: 50rpx;
    line-height: 50rpx;
    padding: 0 14rpx
}

.name_label {
    color: #2d2d2d;
    font-size: 32rpx;
    font-weight: 500;
    margin-left: 20rpx
}

.museum_name {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border: 1rpx solid #dcdcdc;
    border-radius: 4rpx;
    color: #a1a1a1;
    display: -webkit-flex;
    display: flex;
    font-size: 25rpx;
    height: 52rpx;
    margin-left: 21rpx;
    padding: 0 17rpx
}

.right_arrow {
    height: 21rpx;
    margin-left: 45rpx;
    width: 12rpx
}

.exhibitionDateView {
    margin: 0rpx 20rpx 20rpx
}

.exhibitionDateView,.topview {
    background-color: #fff;
    border-radius: 10rpx
}

.topview {
    margin: 30rpx 30rpx 0rpx;
    padding: 10rpx;
    position: relative
}

.topconent {
    top: 30rpx
}

.topstatelab {
    font-size: 26rpx;
    height: 60rpx;
    left: 30rpx;
    line-height: 60rpx;
    top: 90rpx
}

.paybtn,.topstatelab {
    color: #fff;
    position: absolute
}

.paybtn {
    background-color: var(--themeColor);
    border-radius: 10rpx;
    font-size: 24rpx;
    height: 40rpx;
    line-height: 40rpx;
    right: 50rpx;
    text-align: center;
    top: 20rpx;
    width: 120rpx
}

.toptitlelab {
    color: #2d2d2d;
    display: -webkit-flex;
    display: flex;
    font-size: 30rpx;
    line-height: 60rpx;
    margin: 0 25rpx
}

.toplab {
    color: #525252;
    font-size: 24rpx;
    margin: 0 25rpx 0 90rpx
}

.topStateLab,.toplab {
    display: block;
    height: 60rpx;
    line-height: 60rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap
}

.topStateLab {
    color: #3ac3b4;
    font-size: 28rpx;
    margin: 0 25rpx
}

.lineView {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-flow: row;
    flex-flow: row;
    height: 40rpx;
    margin-top: 20rpx
}

.leftline {
    background-color: var(--themeColor);
    height: 1rpx;
    line-height: 1rpx;
    margin: 20rpx;
    width: 280rpx
}

.lineLabstr {
    color: var(--themeColor);
    font-size: 26rpx;
    height: 40rpx;
    line-height: 40rpx
}

.rightlineLab {
    background-color: var(--themeColor);
    height: 1rpx;
    line-height: 1rpx;
    margin: 20rpx;
    width: 280rpx
}

.ListContainer {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    overflow: hidden;
    white-space: nowrap;
    width: 100%
}

.memberlist {
    height: 730rpx;
    margin-top: 30rpx;
    width: 690rpx
}

.qrcode,.qrcodeimg {
    height: 320rpx;
    width: 320rpx
}

.qrcode {
    -webkit-align-self: center;
    align-self: center;
    margin-top: 30rpx;
    z-index: 0
}

.memberconent {
    background-color: #fff;
    border-radius: 10rpx;
    box-sizing: border-box;
    display: inline-block;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-top: 20rpx;
    position: relative
}

.canclebtn {
    background-color: var(--themeColor);
    border-radius: 10rpx;
    color: #fff;
    font-size: 24rpx;
    height: 40rpx;
    line-height: 40rpx;
    position: absolute;
    right: 50rpx;
    text-align: center;
    top: 20rpx;
    width: 120rpx
}

.button_container {
    background-color: #fff;
    bottom: 0rpx;
    gap: 30rpx;
    height: 120rpx;
    padding: 0rpx 30rpx;
    position: fixed;
    width: calc(100% - 60rpx);
    z-index: 500
}

.payView {
    margin-left: 0rpx;
    width: calc(100% - 180rpx)
}

.moneyView {
    color: #595757;
    font-size: 26rpx
}

.moneyStateLab {
    color: #595757;
    display: inline-block
}

.moneyLab {
    color: var(--themeColor);
    display: inline-block;
    min-width: 300rpx;
    padding-left: 15rpx
}

.lessTimeLab {
    color: #dc5858;
    display: inline-block;
    font-size: 26rpx
}

.appointbtnAble {
    height: 60rpx;
    line-height: 60rpx;
    margin-left: 0rpx;
    margin-right: 0rpx;
    width: 180rpx
}

.appointbtnAble,.tuidingBottomBtn {
    background-color: var(--themeColor);
    border-radius: 15rpx;
    color: #fff;
    font-size: 30rpx;
    min-width: 60px;
    text-align: center;
    z-index: 500
}

.tuidingBottomBtn {
    height: 90rpx;
    line-height: 90rpx;
    padding: 20 8rpx;
    width: 690rpx
}

.normore {
    background-color: #c4c6ca
}

.heXiaoBottomBtn {
    background-color: var(--themeColor);
    border-radius: 15rpx;
    color: #fff;
    font-size: 30rpx;
    height: 90rpx;
    line-height: 90rpx;
    min-width: 60px;
    padding: 20 8rpx;
    text-align: center;
    width: 690rpx;
    z-index: 500
}

.heXiaoNormore {
    background-color: #c4c6ca
}

.heXiaoBottomBtn::after,.tuidingBottomBtn::after {
    border: none
}

.seleteimgview {
    height: 40rpx;
    left: 0rpx;
    padding: 30rpx;
    position: absolute;
    top: 0rpx;
    width: 40rpx
}

.trashImg {
    border: 1px dashed var(--themeColor);
    border-radius: 50%
}

.trashImg,.trashImgSeleted {
    display: inline-block;
    height: 40rpx;
    position: absolute;
    top: 50%;
    -webkit-transform: translateY(-50%);
    transform: translateY(-50%);
    width: 40rpx
}

.baozhangPopbgview {
    background: rgba(0,0,0,.7);
    height: 100vh;
    left: 0rpx;
    position: fixed;
    top: 0rpx;
    width: 100%;
    z-index: 1000
}

.baozhangPopview {
    background: #fff;
    border-radius: 30rpx 30rpx 0rpx 0rpx;
    bottom: 0;
    display: inline;
    height: 514rpx;
    position: absolute;
    width: 100%;
    z-index: 1000
}

.baozhangPopTitleView {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 180rpx;
    -webkit-justify-content: center;
    justify-content: center;
    width: 100%;
    z-index: 1000
}

.baozhangTitleImg {
    height: 117rpx;
    width: 272rpx
}

.baozhangCloseImg {
    height: 34rpx;
    padding: 30rpx;
    position: absolute;
    right: 10rpx;
    top: 30rpx;
    width: 34rpx
}

.reserveStatusImg {
    height: 138rpx;
    position: absolute;
    right: 30rpx;
    top: 30rpx;
    width: 164rpx
}

.imgTextView {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 60rpx;
    margin: 0rpx 30rpx
}

.timeImg {
    height: 28rpx;
    width: 26rpx
}

.timeLabel {
    color: #2d2d2d;
    font-size: 28rpx;
    font-weight: 400;
    margin-left: 15rpx;
    margin-right: 40rpx;
    width: 100%
}

.popdescV {
    height: 80rpx;
    margin: 0 30rpx 20rpx
}

.popdescLab {
    color: #a1a1a1;
    font-size: 26rpx;
    line-height: 40rpx;
    white-space: normal
}

.eyesImg {
    height: 30rpx;
    position: absolute;
    right: 70rpx;
    top: 140rpx;
    width: 40rpx
}

.guide {
    -webkit-align-self: center;
    align-self: center;
    background: #fff;
    border-radius: 10rpx;
    margin-bottom: calc(env(safe-area-inset-bottom) + 150rpx);
    margin-top: 30rpx;
    width: 690rpx
}

.guide_title {
    -webkit-align-self: flex-start;
    align-self: flex-start;
    margin-left: 30rpx;
    margin-top: 30rpx
}

.row1 {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: center;
    justify-content: center;
    margin-bottom: 30rpx;
    margin-top: 20rpx;
    width: 100%
}

.row1 > wx-label {
    color: var(--themeColor);
    text-decoration: underline
}
