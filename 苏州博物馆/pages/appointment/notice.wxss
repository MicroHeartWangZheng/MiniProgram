.notice-page {
    box-sizing: border-box;
    max-height: 100vh;
    padding: 30rpx;
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom))
}

.placeholder {
    color: #999;
    font-size: 28rpx;
    padding: 40rpx 0
}

.agree-row {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    flex-direction: row;
    margin: 40rpx 0 20rpx
}

.agree-text {
    font-size: 28rpx;
    margin-left: 16rpx
}

.btn-next {
    background: var(--themeColor);
    border-radius: 12rpx;
    color: #fff;
    font-size: 30rpx;
    margin-top: 20rpx
}

.btn-next::after {
    border: none
}
