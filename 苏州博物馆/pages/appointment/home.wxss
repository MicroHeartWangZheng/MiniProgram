@import "../../publicCss/home.wxss";

.bottom-bar {
    background: #f7f6f7;
    border-top: 1rpx solid #e6e6e6;
    bottom: 0;
    box-sizing: border-box;
    left: 0;
    padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
    position: fixed;
    width: 100%;
    z-index: 99
}

.next-btn {
    background: var(--themeColor);
    border-radius: 12rpx;
    color: #fff;
    font-size: 32rpx;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    width: 100%
}

.next-btn::after {
    border: none
}
