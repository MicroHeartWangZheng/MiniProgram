.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 30rpx;
    padding-bottom: calc(180rpx + env(safe-area-inset-bottom))
}

.card {
    background: #fff;
    border-radius: 12rpx;
    box-shadow: 0 0 6rpx rgba(0,0,0,.06);
    margin-bottom: 24rpx;
    padding: 24rpx
}

.row {
    color: #333;
    font-size: 28rpx;
    line-height: 48rpx
}

.label {
    color: #888
}

.bottom {
    background: #f7f6f7;
    border-top: 1rpx solid #e6e6e6;
    bottom: 0;
    box-sizing: border-box;
    left: 0;
    padding: 24rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
    position: fixed;
    width: 100%
}

.btn {
    background: var(--themeColor);
    border-radius: 12rpx;
    color: #fff;
    font-size: 30rpx;
    margin-bottom: 16rpx
}

.btn::after {
    border: none
}

.btn-plain {
    background: #fff;
    border: 1rpx solid #ccc;
    color: #333
}
