/* @import "..\..\publicCss\home.wxss"; */

page {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    width: 100%
}

.content-view,page {
    background-color: #f9f9f9
}

.section {
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0rpx 0rpx 3rpx 0rpx #cccaca;
    margin: 50rpx 0;
    min-height: 180rpx;
    width: 690rpx
}

.section-header-view {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 80rpx;
    position: relative;
    width: 100%
}

.header_icon {
    height: 21rpx;
    margin-left: 28rpx;
    width: 21rpx;
    z-index: 2
}

.header_text {
    color: #d37c26;
    font-size: 30rpx;
    font-weight: 700;
    height: 80rpx;
    line-height: 80rpx;
    margin-left: 30rpx;
    position: relative;
    z-index: 2
}

.header_bg {
    border-radius: 10rpx 10rpx 0 0;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 1
}

.week_view {
    background-color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    height: 90rpx;
    line-height: 90rpx;
    padding: 0 12rpx
}

.week_view > wx-text {
    font-size: 30rpx;
    margin-left: 3rpx;
    margin-right: 3rpx;
    text-align: center;
    width: calc((690rpx - 24rpx - (6rpx * 7)) / 7)
}

.section-content {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    padding: 10rpx 12rpx 30rpx
}

.date_view,.section-content {
    display: -webkit-flex;
    display: flex
}

.date_view {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 10rpx;
    box-sizing: border-box;
    -webkit-flex-direction: column;
    flex-direction: column;
    gap: 20rpx;
    height: 130rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 15rpx 3rpx;
    position: relative;
    width: calc((690rpx - 24rpx - (6rpx * 7)) / 7)
}

.date_view_disabled,.date_view_disabled_selected {
    background-color: #f6f6f6!important
}

.date_view_disabled_selected {
    border: 1rpx solid var(--themeColor)
}

.date_view_empty {
    background-color: #fff!important
}

.month {
    color: #a0a0a0;
    font-size: 20rpx;
    font-weight: 400;
    line-height: 20rpx
}

.date {
    color: #434343;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 32rpx;
    margin-bottom: 14rpx;
    margin-top: 14rpx
}

.date_disabled {
    color: #b6b6b6
}

.today {
    color: #d37c26;
    font-size: 32rpx;
    font-weight: 500
}

.state {
    color: #ff7f00;
    font-size: 20rpx;
    font-weight: 400;
    height: 20rpx;
    line-height: 0rpx
}

.state_disabled {
    color: #b6b6b6
}

.state_empty {
    color: #fff;
    opacity: 0
}

.selected_icon {
    border-radius: 0 10rpx 0 0;
    height: 21rpx;
    position: absolute;
    right: -1rpx;
    top: -1rpx;
    width: 21rpx
}

.time_view {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff6ed;
    border: 1rpx solid #fff6ed;
    border-radius: 10rpx;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 15rpx;
    position: relative;
    width: calc((100% - 50px) / 3)
}

.time_view_selected {
    background-color: #ffd8b1!important;
    border-color: var(--themeColor)!important
}

.time_view_disabled {
    background-color: #f6f6f6!important
}

.time_hour {
    color: #434343;
    font-size: 26rpx;
    line-height: 26rpx
}

.time_state {
    color: #ff7f00;
    font-size: 22rpx;
    line-height: 22rpx;
    margin-top: 16rpx
}

.tipsView {
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-bottom: 170rpx;
    width: 690rpx
}

.tipsIcon {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    height: 40rpx;
    margin-right: 20rpx;
    width: 40rpx
}

.tipsText {
    color: #ff7f00;
    font-size: 30rpx;
    line-height: 50rpx
}

page {
    -webkit-align-items: unset;
    align-items: unset;
    background-color: #eee;
    padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx)
}

.bg_top {
    width: 100%
}

.bg_top wx-image {
    height: 450rpx;
    width: 100%
}

.nav {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 64rpx;
    position: fixed;
    text-align: center;
    width: 100%
}

.return {
    box-sizing: border-box;
    height: 64rpx;
    margin-left: 18rpx;
    padding: 12rpx;
    width: 64rpx
}

.info {
    background-color: #fff;
    border-radius: 10rpx;
    margin: 25rpx 30rpx;
    padding: 0 30rpx 30rpx
}

.info .title {
    border-bottom: 1rpx solid #eee;
    color: #434343;
    font-size: 34rpx;
    padding: 28rpx 0
}

.detail {
    background-color: #fff;
    border-radius: 10rpx;
    margin: 0 30rpx;
    padding: 0 30rpx 30rpx
}

.detail .title {
    color: #434343;
    font-size: 30rpx;
    margin: 34rpx 0
}

.btn {
    background-color: #fff;
    bottom: 0;
    height: 167rpx;
    position: fixed;
    width: 100%
}

.btn wx-view {
    background-color: #bbaa70;
    border-radius: 10rpx;
    color: #fff;
    font-size: 30rpx;
    height: 95rpx;
    line-height: 95rpx;
    margin: 23rpx 24rpx;
    text-align: center
}

.info .c {
    color: #a0a0a0;
    display: -webkit-flex;
    display: flex;
    font-size: 25rpx;
    margin-top: 20rpx
}

.info .t {
    color: #434343;
    margin-right: 27rpx;
    white-space: nowrap
}

.info .activity_time {
    margin-top: 37rpx
}

.activity_cost .p {
    color: #b25c43
}

.batch {
    background-color: #fff;
    border-radius: 10rpx;
    margin: 24rpx 30rpx
}

.batch .top {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    font-size: 30rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-bottom: 15rpx;
    padding: 35rpx 30rpx 0
}

.batch .top .left {
    color: #434343
}

.batch .top .right {
    color: var(--themeColor);
    font-size: 24rpx
}

.batch .top .leftIcon {
    height: 14rpx;
    margin-left: 10rpx;
    vertical-align: middle
}

.batchlist {
    background-color: rgba(182,126,221,.15);
    border-radius: 10rpx;
    margin: 0 30rpx 20rpx;
    padding: 30rpx
}

.batch_time {
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.batch_time .time {
    color: #626262;
    font-weight: 700
}

.batch_time .cost {
    color: #b25c43;
    font-size: 25rpx
}

.batchlist .reverse {
    color: var(--themeColor);
    font-size: 25rpx;
    margin-top: 16rpx
}

.batchlist .label_box {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-end;
    justify-content: flex-end;
    margin-top: 18rpx;
    width: 100%
}

.batchlist .batch_label {
    background-color: #b5b5b5;
    border-radius: 10rpx;
    color: #fff;
    font-size: 22rpx;
    height: 42rpx;
    line-height: 42rpx;
    text-align: right;
    text-align: center;
    width: 131rpx
}

.date_box {
    background-color: rgba(0,0,0,.5);
    height: 100vh;
    left: 0;
    top: 0;
    z-index: 1000
}

.content-view,.date_box {
    position: fixed;
    width: 100%
}

.content-view {
    -webkit-align-items: center;
    align-items: center;
    background-color: unset;
    bottom: 0;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    padding-bottom: 0
}

.section {
    margin: 0;
    width: 100%
}

.week_view {
    border-bottom: 1rpx solid #eee;
    border-top: 1rpx solid #eee;
    padding: 0 30rpx
}

.section-content {
    padding: 10rpx 30rpx 30rpx
}

.date_view,.week_view > wx-text {
    width: calc((100% - (6rpx * 7)) / 7)
}

.month_view {
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 60rpx;
    padding: 20rpx 0;
    width: 100%
}

.month_view,.next_month_box {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 60rpx
}

.next_month_box {
    width: 60rpx
}

.last_month {
    margin-right: 15rpx
}

.next_month {
    margin-left: 15rpx
}

.last_month,.next_month {
    display: block;
    width: 36rpx
}

.specicalType {
    -webkit-align-items: center;
    align-items: center;
    background-color: var(--themeColor);
    border-bottom-right-radius: 10rpx;
    color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 22rpx;
    left: 0;
    padding: 10rpx 15rpx;
    position: absolute;
    top: 180rpx
}

.specicalType .specialIcon {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    margin-right: 8rpx;
    width: 28rpx
}

.batchlist_tips {
    color: #b25c43;
    font-size: 25rpx;
    margin-bottom: 30rpx;
    padding: 0 30rpx
}

.ticketItem {
    background-color: #eee;
    border-radius: 16rpx;
    box-sizing: border-box;
    margin-top: 10rpx;
    padding: 20rpx
}

.ticketItem .tickettop {
    color: #434343;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between
}

.tickettop .ticket_price {
    color: #b25c43
}

.ticketbottom {
    color: #a0a0a0;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-top: 15rpx
}

.ticketbottom .reserveBtn {
    background-color: var(--themeColor);
    border-radius: 8rpx;
    color: #fff;
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    font-size: 25rpx;
    height: 50rpx;
    line-height: 50rpx;
    margin-left: 10rpx;
    padding: 0 10rpx;
    text-align: center
}

.ticketbottom .disableRe {
    background-color: #b5b5b5
}

.selBg {
    background-color: var(--themeColor)
}

.selBg,.selBg .ticket_price,.selBg .ticketbottom,.selBg .tickettop {
    color: #fff
}
