.orderDetail {
    background-color: #fff;
    border-radius: 10rpx;
    margin: 130rpx 30rpx 50rpx
}

.orderDetail .success {
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1px solid #eee;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    font-size: 34rpx;
    font-weight: 600;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 80rpx;
    margin-bottom: 30rpx;
    margin-top: 40rpx
}

.orderDetail .success .success_img {
    height: 120rpx
}

.info {
    border-bottom: 1px solid #eee;
    margin: 0 30rpx;
    padding: 30rpx 0
}

.info .c {
    color: #626262;
    font-size: 25rpx;
    margin-bottom: 20rpx
}

.info .c:last-child {
    margin-bottom: 0
}

.info .n {
    color: #b5b5b5;
    margin-left: 27rpx
}

.prompt {
    margin: 0 30rpx
}

.prompt .t {
    color: #434343;
    font-size: 30rpx;
    margin-bottom: 30rpx;
    margin-top: 35rpx
}

.btn {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    margin-bottom: 64rpx;
    margin-top: 76rpx
}

.btn wx-view {
    background-color: var(--themeColor);
    border-radius: 10rpx;
    color: #fff;
    font-size: 30rpx;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    width: 258rpx
}

.btn .back {
    background-color: #fff;
    border-bottom-width: 1rpx;
    border-bottom: 2rpx solid var(--themeColor);
    border-left: 1rpx solid var(--themeColor);
    border-right: 1rpx solid var(--themeColor);
    border-top-width: 1rpx;
    border-top: 2rpx solid var(--themeColor);
    color: var(--themeColor)
}

.top_img {
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: -1
}

.prompt .tips {
    color: #a0a0a0!important;
    font-size: 25rpx!important;
    line-height: 40rpx!important
}
