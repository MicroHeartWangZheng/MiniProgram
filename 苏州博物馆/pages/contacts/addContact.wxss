page {
    border-top: 1rpx solid #dfdfdf
}

.cellview {
    border-bottom: 1rpx solid #dfdfdf;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    font-size: 28rpx;
    height: 130rpx;
    margin-left: 20rpx;
    padding: 20rpx 0;
    position: relative
}

.cellTitlelab {
    color: #595757;
    height: 60rpx;
    line-height: 60rpx;
    min-width: 100%
}

.inputview {
    background-color: initial;
    height: 70rpx;
    line-height: 70rpx;
    width: 90%
}

.firstLine {
    width: 350rpx
}

.unfoldimg {
    bottom: 40rpx;
    height: 17rpx;
    padding: 10rpx 10rpx 10rpx 40rpx;
    position: absolute;
    right: 50rpx;
    width: 33rpx
}

.buttomview {
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-evenly;
    justify-content: space-evenly;
    margin-top: 30rpx
}

.normalBtn {
    border-radius: 10rpx;
    font-size: 30rpx;
    height: 80rpx;
    line-height: 80rpx;
    width: 300rpx
}

.userChooseView {
    border-left: 1rpx solid #dfdfdf;
    height: 110rpx;
    position: absolute;
    right: 0;
    top: 30rpx;
    width: 340rpx;
    z-index: 2
}

.chooseInnerView {
    height: 100%;
    position: relative;
    width: 100%
}

.userPromptLab {
    color: #898989;
    font-size: 24rpx;
    height: 40rpx;
    left: 60rpx;
    line-height: 40rpx;
    position: absolute;
    top: 0rpx
}

.chooseTureImg {
    height: 30rpx;
    left: 60rpx;
    position: absolute;
    top: 65rpx;
    width: 30rpx
}

.yesLab {
    color: #898989;
    font-size: 24rpx;
    height: 40rpx;
    left: 85rpx;
    line-height: 40rpx;
    position: absolute;
    text-align: center;
    top: 60rpx;
    width: 60rpx
}

.chooseNoImg {
    height: 30rpx;
    left: 160rpx;
    position: absolute;
    top: 65rpx;
    width: 30rpx
}

.noLab {
    color: #898989;
    left: 185rpx;
    top: 60rpx;
    width: 60rpx
}

.HiddleUserBtn,.noLab {
    font-size: 24rpx;
    height: 40rpx;
    line-height: 40rpx;
    position: absolute;
    text-align: center
}

.HiddleUserBtn {
    background-color: #fff;
    border: 1rpx solid var(--themeColor);
    border-radius: 12rpx;
    color: var(--themeColor);
    left: 75px;
    top: 20rpx;
    width: 120rpx
}

.HiddleUserBtn::after {
    border: none
}

.HiddleUserBtn.selected {
    background-color: var(--themeColor);
    color: #fff
}

.xieyiView {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin: 90rpx 30rpx 10rpx
}

.xieyiImg {
    height: 30rpx;
    width: 30rpx
}

.xieyiLab {
    color: #595757;
    margin-left: 15rpx
}

.xieyiLab,.xieyiLabS {
    font-size: 28rpx;
    font-weight: 400
}

.xieyiLabS {
    color: var(--themeColor);
    margin-left: 8rpx
}

.dangChooseView {
    display: inline-block
}

.radioLab {
    margin-left: auto
}

.radioLab2 {
    margin-left: 40rpx
}

.tipsView {
    -webkit-align-self: center;
    align-self: center;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-top: 30rpx;
    width: 690rpx
}

.tipsIcon {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    height: 40rpx;
    margin-right: 20rpx;
    width: 40rpx
}

.tipsText {
    color: var(--themeColor);
    font-size: 30rpx;
    line-height: 50rpx
}
