.container,page {
    height: 100%;
    margin: 0;
    padding: 0;
    width: 100%
}

.container {
    overflow: hidden;
    position: relative
}

.poster {
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%
}

.countdown {
    background-color: rgba(0,0,0,.5);
    border-radius: 10rpx;
    color: #fff;
    font-size: 28rpx;
    padding: 10rpx 0;
    position: absolute;
    text-align: center;
    width: 140rpx
}
