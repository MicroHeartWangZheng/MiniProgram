page {
    -webkit-align-items: center;
    align-items: center;
    background-color: #f9f9f9;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    width: 100%
}

.section {
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0rpx 0rpx 3rpx 0rpx #cccaca;
    margin: 35rpx 0;
    min-height: 180rpx;
    width: 690rpx
}

.section-header-view {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    height: 80rpx;
    position: relative;
    width: 100%
}

.header_icon {
    height: 21rpx;
    margin-left: 28rpx;
    width: 21rpx;
    z-index: 2
}

.header_text {
    color: #d37c26;
    font-size: 30rpx;
    font-weight: 700;
    height: 80rpx;
    line-height: 80rpx;
    margin-left: 30rpx;
    position: relative;
    z-index: 2
}

.header_bg {
    border-radius: 10rpx 10rpx 0 0;
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 1
}

.week_view {
    background-color: #fff;
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    height: 90rpx;
    line-height: 90rpx;
    padding: 0 12rpx
}

.week_view > wx-text {
    font-size: 30rpx;
    margin-left: 3rpx;
    margin-right: 3rpx;
    text-align: center;
    width: calc((690rpx - 24rpx - (6rpx * 7)) / 7)
}

.section-content {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    padding: 10rpx 12rpx 30rpx
}

.date_view,.section-content {
    display: -webkit-flex;
    display: flex
}

.date_view {
    -webkit-align-items: center;
    align-items: center;
    background: #fff6ed;
    border-radius: 10rpx;
    box-sizing: border-box;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 130rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 15rpx 3rpx;
    position: relative;
    width: calc((690rpx - 24rpx - (6rpx * 7)) / 7)
}

.date_view_selected {
    background-image: url("data:image/png;base64,");
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: 100% 100%
}

.date_view_disabled {
    background-color: #f6f6f6!important
}

.date_view_disabled_selected {
    background-image: url("data:image/png;base64,");
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: 100% 100%
}

.date_view_empty {
    background-color: #fff!important
}

.month {
    color: #a0a0a0;
    font-size: 20rpx;
    font-weight: 400;
    line-height: 20rpx
}

.date {
    color: #434343;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 32rpx;
    margin-bottom: 14rpx;
    margin-top: 14rpx
}

.date_disabled {
    color: #b6b6b6
}

.today {
    color: #d37c26;
    font-size: 28rpx;
    font-weight: 500
}

.state {
    color: #ff7f00;
    font-size: 18rpx;
    font-weight: 400;
    height: 20rpx;
    line-height: 20rpx
}

.state_disabled {
    color: #b6b6b6;
    text-align: center
}

.state_empty {
    color: #fff;
    opacity: 0
}

.selected_icon {
    border-radius: 0 10rpx 0 0;
    height: 21rpx;
    position: absolute;
    right: -1rpx;
    top: -1rpx;
    width: 21rpx
}

.time_view {
    -webkit-align-items: center;
    align-items: center;
    background-color: #fff6ed;
    border: 1rpx solid #fff6ed;
    border-radius: 10rpx;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    height: 100rpx;
    -webkit-justify-content: center;
    justify-content: center;
    margin: 15rpx;
    position: relative;
    width: calc((100% - 50px) / 3)
}

.time_view_selected {
    background-image: url("data:image/png;base64,");
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: 100% 100%
}

.time_view_disabled {
    background-color: #f6f6f6!important
}

.time_hour {
    color: #434343;
    font-size: 26rpx;
    line-height: 26rpx
}

.time_state {
    color: #ff7f00;
    font-size: 22rpx;
    line-height: 22rpx;
    margin-top: 16rpx
}

.tipsView {
    background: #fff;
    border-radius: 10rpx;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-bottom: 155rpx;
    padding: 0 30rpx 30rpx;
    width: 630rpx
}

.tipsIcon {
    -webkit-flex-shrink: 0;
    flex-shrink: 0;
    height: 40rpx;
    margin-right: 20rpx;
    width: 40rpx
}

.tipsText {
    color: #1b1b1b;
    font-size: 30rpx;
    line-height: 50rpx
}

.tipsTextRed {
    color: red;
    font-weight: 700
}
