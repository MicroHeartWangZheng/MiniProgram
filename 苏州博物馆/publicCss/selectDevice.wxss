page {
    -webkit-align-items: center;
    align-items: center;
    font-size: 28rpx;
    overflow: scroll;
    padding-bottom: 0
}

.top {
    -webkit-align-items: flex-start;
    align-items: flex-start;
    background: #fff;
    border-radius: 10rpx;
    box-sizing: border-box;
    margin-top: 30rpx;
    padding-left: 30rpx;
    padding-right: 30rpx;
    width: 690rpx
}

.museum_name {
    font-size: 32rpx;
    font-weight: 700;
    line-height: 32rpx;
    padding-bottom: 30rpx;
    padding-top: 30rpx;
    width: 100%
}

.time {
    border-top: 1rpx solid #f6f6f6;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    padding-bottom: 20rpx;
    padding-top: 20rpx;
    width: 100%
}

.item {
    background: #fff;
    border-radius: 10rpx;
    box-sizing: border-box;
    margin-top: 30rpx;
    padding: 30rpx;
    width: 690rpx
}

.main_user {
    -webkit-align-self: flex-end;
    align-self: flex-end
}

.user {
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin-top: 20rpx;
    width: 100%
}

.user > wx-label:nth-child(1) {
    font-weight: 600
}

.user > wx-label:nth-child(2) {
    margin-left: 30rpx
}

.deviceView {
    -webkit-flex-wrap: wrap;
    flex-wrap: wrap;
    -webkit-justify-content: flex-start;
    justify-content: flex-start;
    margin-top: 6rpx;
    width: 100%
}

.device {
    margin-right: 14rpx;
    margin-top: 14rpx
}

.bottom {
    -webkit-align-items: center;
    align-items: center;
    background: #fff;
    border-bottom: calc(env(safe-area-inset-bottom)) solid #fff;
    border-top: 1rpx solid #ddd;
    bottom: 0;
    -webkit-flex-direction: row;
    flex-direction: row;
    height: 124rpx;
    position: fixed;
    width: 100%;
    z-index: 100
}

.bottom,.left {
    display: -webkit-flex;
    display: flex
}

.left {
    -webkit-flex-direction: column;
    flex-direction: column;
    margin-left: 30rpx
}

.price {
    color: #595757;
    font-size: 30rpx
}

.price_num {
    color: var(--themeColor);
    font-size: 34rpx;
    font-weight: 600;
    margin-left: 20rpx
}

.countDownTime {
    color: var(--themeColor);
    font-size: 25rpx;
    font-weight: 400;
    margin-top: 8rpx
}

.payBtn {
    border-radius: 4rpx;
    color: #fff;
    height: 64rpx;
    line-height: 64rpx;
    margin-left: auto;
    margin-right: 30rpx;
    text-align: center;
    width: 258rpx
}

wx-radio .wx-radio-input {
    margin-right: 10rpx
}

.vipView {
    background-color: #fff;
    border-top: 1rpx solid #ddd;
    bottom: calc(env(safe-area-inset-bottom) + 124rpx);
    -webkit-flex-direction: column;
    flex-direction: column;
    position: fixed;
    width: 100%
}

.vipView,.vip_title {
    display: -webkit-flex;
    display: flex
}

.vip_title {
    -webkit-align-items: center;
    align-items: center;
    -webkit-flex-direction: row;
    flex-direction: row;
    margin-left: 30rpx
}

.vip_title_label1 {
    font-size: 32rpx;
    font-weight: 700;
    line-height: 32rpx;
    margin-bottom: 30rpx;
    margin-top: 30rpx
}

.vip_title_label2 {
    color: #595757
}

.price_row {
    border-top: 1rpx dashed #ddd;
    height: 70rpx;
    margin-left: 30rpx;
    margin-right: 30rpx
}

.row_title {
    color: #000
}

.row_price {
    color: #000;
    margin-left: auto
}

.conpon_tips {
    color: var(--activeColor);
    font-size: 28rpx;
    line-height: 28rpx;
    margin: 10rpx 30rpx 20rpx
}

.arrow {
    height: 30rpx;
    width: 30rpx
}