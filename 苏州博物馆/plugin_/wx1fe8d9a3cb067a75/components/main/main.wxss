        transform: scale(1,1)
    }
}

@-webkit-keyframes dot1 {
    to {
        left: 26px
    }
}

@keyframes dot1 {
    to {
        left: 26px
    }
}

@-webkit-keyframes dot2 {
    to {
        left: 39px
    }
}

@keyframes dot2 {
    to {
        left: 39px
    }
}

@-webkit-keyframes dot3 {
    80% {
        left: 39px
    }

    100% {
        left: 44px;
        -webkit-transform: scale(.4,.4);
        transform: scale(.4,.4)
    }
}

@keyframes dot3 {
