.mp-box{background-color:#fff}.mp-cell{align-items:center;border-bottom:2rpx solid #e5e5e5;display:-webkit-flex;display:flex;margin:0 30rpx;padding:28rpx 10rpx}.mp-cell:last-child{border-bottom:none}.mp-cell-hd{color:#999;font-size:28rpx;width:4rem}.mp-cell-bd{flex:1}.mp-btnbox{margin-top:120rpx}.code-btn{color:#333;font-size:28rpx}.discode-btn{color:#999;font-size:28rpx}.auz-box{background:#fff;border-top:1px solid #e6e6e6;padding:40rpx}.auz-img{height:100rpx;width:100rpx}.auz-text{display:inline-block;line-height:1.6;margin-top:30rpx}.url-title{color:#ac732e;text-decoration:underline}.auz-btnbox{margin:60rpx 40rpx 0}.auz-btn{border-radius:45rpx;font-size:30rpx;height:90rpx;line-height:90rpx}.auz-btn[disabled]{background:#cecece!important;border-color:#cecece!important;color:#fff!important}.gray-btn{color:#ac732e;font-size:30rpx;margin:40rpx 0 0;text-align:center;width:auto}.radio-box{margin-bottom:20rpx}.radio-lbl{display:inline-block;font-size:26rpx;line-height:1}.link{color:#ac732e}radio .wx-radio-input{border-radius:50%;height:32rpx;width:32rpx}radio .wx-radio-input.wx-radio-input-checked::before{border-radius:50%;font-size:20rpx;height:36rpx;line-height:36rpx;width:36rpx}