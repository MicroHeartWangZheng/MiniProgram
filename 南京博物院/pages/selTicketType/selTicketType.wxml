    </view>
    <view class="notice-bot flex s-center">
        <button bindtap="closeBox" class="primary-btn confirm-btn" disabled="{{timeFlag}}">我知道了<text wx:if="{{timeFlag}}">（{{second}}s）</text>
        </button>
    </view>
</view>
<view catchtouchmove="true" class="mask-box" hidden="{{noticeBox}}"></view>
<view class="notice-box notice-box1" hidden="{{noticeBox}}">
    <view class="n-content">
        <rich-text class="rich-text" nodes="{{msg}}"></rich-text>
    </view>
    <button bindtap="goNext1" class="notice-btn">确定</button>
</view>
