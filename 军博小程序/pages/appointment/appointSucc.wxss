.banner-top{height:390rpx;width:752rpx}.sectionview{background-color:#fff;border-radius:10rpx;margin:0 30rpx;position:absolute;top:160rpx;width:690rpx}.success-icon{margin-bottom:30rpx;margin-top:40rpx;text-align:center}.success-icon image{height:120rpx;width:160rpx}.success-icon label{display:block;font-size:34rpx;font-weight:600;line-height:80rpx;transform:translateX(4rpx)}.time-tips{border:1rpx dashed #e0e0e0;display:-webkit-flex;display:flex;font-size:30rpx;height:70rpx;margin:0 30rpx;padding-left:60rpx}.time-tips label{line-height:70rpx}.time-tips :last-child{color:var(--themeColor)}.rich_text{color:#c0392b;display:block;font-size:28rpx;line-height:40rpx;margin:30rpx}.buttomview{display:-webkit-flex;display:flex;justify-content:center;margin-bottom:20rpx;margin-top:100rpx}.buttomview :last-child{background-color:#fff;border:1rpx solid #b3b3b3;color:#000}.buttomview button{background-color:var(--themeColor);border-radius:10rpx;color:#fff;cursor:pointer;font-size:30rpx;height:80rpx;text-align:center;width:300rpx}.surebtn::after{border:none}