page{align-items:center;display:-webkit-flex;display:flex;flex-direction:column;width:100%}.content-view,page{background-color:#f9f9f9}.content-view{padding-bottom:170rpx}.section{background-color:#fff;border-radius:10rpx;box-shadow:0rpx 0rpx 3rpx 0rpx #cccaca;margin:50rpx 0;min-height:180rpx;width:690rpx}.section-header-view{align-items:center;display:-webkit-flex;display:flex;height:80rpx;position:relative;width:100%}.header_icon{height:21rpx;margin-left:28rpx;width:21rpx;z-index:2}.header_text{color:#8f6e3a;font-size:30rpx;font-weight:700;height:80rpx;line-height:80rpx;margin-left:12rpx;position:relative;z-index:2}.header_bg{border-radius:10rpx 10rpx 0 0;height:100%;left:0;position:absolute;top:0;width:100%;z-index:1}.week_view{background-color:#fff;display:-webkit-flex;display:flex;font-size:28rpx;height:90rpx;line-height:90rpx;padding:0 12rpx}.week_view>text{font-size:30rpx;margin-left:3rpx;margin-right:3rpx;text-align:center;width:calc((690rpx - 24rpx - (6rpx*7))/7)}.section-content{flex-wrap:wrap;padding:10rpx 12rpx 30rpx}.date_view,.section-content{display:-webkit-flex;display:flex}.date_view{align-items:center;background:#f7f3e9;border-radius:10rpx;box-sizing:border-box;flex-direction:column;height:130rpx;justify-content:center;margin:15rpx 3rpx;position:relative;width:calc((690rpx - 24rpx - (6rpx*7))/7)}.date_view_selected{background-color:#f1e5c6!important;border:1rpx solid var(--themeColor)}.date_view_disabled{background-color:#f6f6f6!important}.date_view_empty{background-color:#fff!important}.month{color:#a0a0a0;font-size:20rpx;font-weight:400;line-height:20rpx}.date{color:#434343;font-size:32rpx;font-weight:500;line-height:32rpx;margin-bottom:14rpx;margin-top:14rpx}.date_disabled{color:#b6b6b6}.today{color:#987844;font-size:32rpx;font-weight:500}.state{color:#bbaa70;font-size:20rpx;font-weight:400;height:20rpx;line-height:20rpx}.state_disabled{color:#b6b6b6}.state_empty{color:#fff;opacity:0}.selected_icon{border-radius:0 11rpx 0 0;height:21rpx;position:absolute;right:-1rpx;top:-1rpx;width:21rpx}.time_view{align-items:center;background-color:#f7f3e9;border:1rpx solid #f6f6f6;border-radius:10rpx;box-sizing:border-box;display:-webkit-flex;display:flex;flex-direction:column;height:100rpx;justify-content:center;margin:15rpx;position:relative;width:calc((100% - 50px)/3)}.time_view_selected{background-color:#f1e5c6!important;border-color:var(--themeColor)!important}.time_view_disabled{background-color:#f6f6f6!important}.time_hour{color:#434343;font-size:26rpx;line-height:26rpx}.time_state{color:#bbaa70;font-size:22rpx;line-height:22rpx;margin-top:16rpx}