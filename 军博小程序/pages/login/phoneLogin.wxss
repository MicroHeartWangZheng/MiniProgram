page{background-color:#fff}.phonelogin{display:-webkit-flex;display:flex;flex-direction:column;min-height:calc(100vh - env(safe-area-inset-bottom));width:100%}.banner-top{width:100%}.form-field,.imgCode,.input{align-items:center;border-bottom:1rpx solid #eee;box-sizing:border-box;color:#626262;display:-webkit-flex;display:flex;font-size:29rpx;margin:0 30rpx;padding-bottom:15rpx;padding-top:15rpx}.input_title{width:60px}.inputRight{color:var(--themeColor);font-size:29rpx}.code-lab,.number-TF,.number-code,.phoneCode{font-size:29rpx;height:76rpx;line-height:76rpx}.code-lab{margin-left:auto;width:450rpx}.code-btn{color:var(--themeColor)}.code-btn,.code-btn-count{background-color:#fff;font-size:29rpx;margin:0 0 0 auto;padding:0}.code-btn-count{color:#a5a2a2}.code-btn-count::after,.code-btn::after{border:none}.login-view{padding:70px 30rpx 30rpx}.login-view>text{color:#b1b0b0;font-size:28rpx;line-height:40rpx;padding:10rpx}.login-btn,.login-btn-count{background-color:var(--themeColor);border-radius:10rpx;color:#fff;font-size:32rpx;height:80rpx;line-height:80rpx;margin-top:20rpx;min-width:60px;padding:20 8rpx;text-align:center;width:100%}.login-btn-count::after,.login-btn::after{border:none}.captcha{border-radius:4rpx;height:44rpx;margin-left:auto;width:156rpx}.login_type2{align-items:center;align-self:center;color:var(--themeColor);display:-webkit-flex;display:flex;flex-direction:row;font-size:30rpx;margin-top:30rpx}.arrow{height:28rpx;margin-left:10rpx;width:16rpx}